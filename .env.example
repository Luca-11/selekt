# Notion — https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxx

# IDs des sources de données (data source), extraits de l'URL Notion
NOTION_BRANDS_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NOTION_RETAILERS_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NOTION_ACCOUNTS_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Rétrocompat — alias de NOTION_BRANDS_DATABASE_ID si les 3 IDs ci-dessus ne sont pas tous définis
NOTION_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Admin — mot de passe pour /admin
ADMIN_PASSWORD=choisis-un-mot-de-passe-fort

# IA (optionnel — sans clé, le scrap meta fonctionne quand même)
# Forcer le provider : openai | anthropic (sinon OpenAI est prioritaire si les deux existent)
AI_PROVIDER=openai

# Anthropic — laisser vide ou supprimer la ligne si tu n'utilises pas Claude
# ANTHROPIC_API_KEY=sk-ant-api03-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI (ChatGPT API)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
